# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/sutragram-dev

# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# For physical devices on same WiFi, replace with your LAN IP (example):
# FRONTEND_URL=http://192.168.1.100:5173

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
# Example with LAN IP:
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://192.168.1.100:3000,http://192.168.1.100:3001,http://192.168.1.100:5173,http://192.168.1.100:8081

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=30d

# Encryption (AES-256 for PII) - MUST be 64 hex characters (32 bytes)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Email Service (Brevo/Sendinblue)
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@snacktrack.me
BREVO_SENDER_NAME=SutraGram
ADMIN_EMAIL=admin@sutragram.com

# SMS Service (Twilio - Disabled by default)
ENABLE_SMS=false
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# DigitalOcean Spaces (S3-compatible)
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=sutragram-media
DO_SPACES_ACCESS_KEY=your-do-spaces-access-key
DO_SPACES_SECRET_KEY=your-do-spaces-secret-key
DO_SPACES_CDN_ENDPOINT=https://sutragram-media.nyc3.cdn.digitaloceanspaces.com

# Payment Gateway (Razorpay)
# Test keys for development
RAZORPAY_KEY_ID=rzp_test_SLYAr0QqnA1HkO
RAZORPAY_KEY_SECRET=xJ33fwHiO2yHjqx9sa5QzVEn

# Analytics & Performance
ENABLE_ANALYTICS=true
ANALYTICS_REFRESH_INTERVAL=86400

# Video Processing
FFMPEG_PATH=/usr/bin/ffmpeg
VIDEO_COMPRESSION_QUALITY=1000k
VIDEO_MAX_RESOLUTION=1280x720

# Automation
ENABLE_CRON_JOBS=true
PAYOUT_PROCESSING_TIME=0 0 * * *
ANALYTICS_AGGREGATION_TIME=0 1 * * *
DATA_CLEANUP_TIME=0 2 * * *
