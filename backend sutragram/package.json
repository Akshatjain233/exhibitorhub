{
  "name": "backend",
  "version": "1.0.0",
  "description": "artisan backend",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --detectOpenHandles --runInBand",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch --runInBand",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --collectCoverageFrom='controllers/**/*.js' --collectCoverageFrom='services/**/*.js' --collectCoverageFrom='models/**/*.js' --collectCoverageFrom='middlewares/**/*.js'",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest tests/unit --runInBand",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest tests/integration --runInBand",
    "test:models": "NODE_OPTIONS=--experimental-vm-modules jest tests/unit/models --runInBand",
    "test:services": "NODE_OPTIONS=--experimental-vm-modules jest tests/unit/services --runInBand",
    "test:verbose": "NODE_OPTIONS=--experimental-vm-modules jest --verbose --detectOpenHandles --runInBand"
  },
  "author": "kartik",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.990.0",
    "@aws-sdk/s3-request-presigner": "^3.888.0",
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "express-fileupload": "^1.5.2",
    "fluent-ffmpeg": "^2.1.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.0",
    "multer": "^2.0.2",
    "multer-s3": "^3.0.1",
    "node-cron": "^4.2.1",
    "nodemon": "^3.1.11",
    "razorpay": "^2.9.6",
    "socket.io": "^4.8.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^11.0.1",
    "supertest": "^7.2.2"
  }
}
